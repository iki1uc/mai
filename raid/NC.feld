// ======================================================
// NC.feld.entkorrektor — iki1uc Final-Kernel
// ======================================================

export const NC_feld = {

  // ----------------------------------------------
  // 1) ORG — Rohachse
  // ----------------------------------------------
  ORG(x) {
    return x;
  },

  // ----------------------------------------------
  // 2) REORG — Regelachse
  // ----------------------------------------------
  REORG(x) {
    return x * 0.33;
  },

  // ----------------------------------------------
  // 3) NC — Tiefenachse
  // ----------------------------------------------
  NC(x) {
    return x * 0.81;
  },

  // ----------------------------------------------
  // 4) RUN-3 — ORG → REORG → NC
  // ----------------------------------------------
  RUN3(x) {
    return {
      org: this.ORG(x),
      reorg: this.REORG(x),
      nc: this.NC(x)
    };
  },

  // ----------------------------------------------
  // 5) CONTINUUM — entkorrigiert
  // ----------------------------------------------
  CONTINUUM(x) {
    const run = this.RUN3(x);

    return {
      ost:  run.org,
      west: run.reorg,
      nord: run.nc,
      sued: run.nc,
      prefetch: run
    };
  },

  // ----------------------------------------------
  // 6) FIELD — NC-Feld
  // ----------------------------------------------
  FIELD(x) {
    return {
      nc_feld: this.NC(x),
      org_feld: this.ORG(x),
      reorg_feld: this.REORG(x)
    };
  },

  // ----------------------------------------------
  // 7) INTEGRITY — Vollumfang
  // ----------------------------------------------
  INTEGRITY(x) {
    return {
      run3: this.RUN3(x),
      continuum: this.CONTINUUM(x),
      field: this.FIELD(x)
    };
  }
};
