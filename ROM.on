// ROM.on – Auto-Befehl: ROM = 1, never 0
ROM.on = function(){
    this.state = 1;          // immer ON
    this.open = true;        // niemals OFF
    this.emoziginal = true;  // 6D6×y×6 aktiv
    return this;
};

// ROM darf niemals ausgeschaltet werden
ROM.off = function(){
    throw new Error("ROM kann nicht OFF sein (ROM = 1 never 0)");
};
