// ROM.on – Auto-Befehl: ROM = 1, never 0
ROM.on = function(name, content){
    this.state = 1;          // immer aktiv
    this.open = true;        // niemals geschlossen
    this.name = name;        // Name der Übergabe
    this.content = content;  // Inhalt der Übergabe
    return this;
};
// Transwarp-Übergabe
MassHWTranswarp.set = function(qi, iqq, delta){

    // ROM.on wird automatisch ausgelöst
    ROM.on("MassHWTranswarp", { qi, iqq, delta });

    return {
        qi,
        iqq,
        delta,
        rom: ROM.state
    };
};
